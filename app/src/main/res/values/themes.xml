<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A bare splash theme. Everything visible is drawn by Compose, so the only job
        here is to keep the window from flashing white on a dark device before the
        first frame arrives.
    -->
    <style name="Theme.Imogen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
