<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device.

    The account store holds refresh tokens sealed against a key in the platform keystore,
    which does not travel with a backup — so a restored copy would be an unreadable blob
    at best. The backup ledger is a record of what this handset has already uploaded, and
    is meaningless on another one. There is nothing here worth carrying across.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
